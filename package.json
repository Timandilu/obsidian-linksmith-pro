{
	"name": "linksmith-pro",
	"version": "1.0.1",
	"description": "Suggest links to notes and headings as you type, then find missing links with a review-first batch tool.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"format": "prettier --write main.ts src tests styles.css *.json *.md *.mjs",
		"format:check": "prettier --check main.ts src tests styles.css *.json *.md *.mjs",
		"test": "node --test tests/*.test.mjs",
		"lint": "eslint main.ts src --max-warnings 0",
		"check": "npm run format:check && npm run lint && npm test && npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Timon Wendland",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Timandilu/obsidian-linksmith-pro.git"
	},
	"bugs": {
		"url": "https://github.com/Timandilu/obsidian-linksmith-pro/issues"
	},
	"homepage": "https://github.com/Timandilu/obsidian-linksmith-pro#readme",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^25.0.0",
		"esbuild": "^0.28.0",
		"eslint": "^10.10.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.13.0",
		"prettier": "^3.9.6",
		"typescript": "~5.9.0",
		"typescript-eslint": "^8.70.0"
	}
}
